# Copy to .env and fill in for real Postgres/Snowflake connections.
# The bundled example configs use local DuckDB stand-ins and don't need these.

SRC_PG_HOST=localhost
SRC_PG_DATABASE=adventureworks
SRC_PG_USER=postgres
SRC_PG_PASSWORD=changeme

SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=ADVENTUREWORKS_DWH
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=changeme
